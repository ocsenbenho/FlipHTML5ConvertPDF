{
  "manifest_version": 3,
  "name": "Flipbook to PDF",
  "version": "1.0.0",
  "description": "Tự động quét, lật trang và tải flipbook HTML5 thành file PDF.",
  "permissions": [
    "activeTab",
    "scripting",
    "webRequest",
    "downloads",
    "storage",
    "offscreen",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flipbook to PDF"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["adapters/generic.js", "adapters/fliphtml5.js", "adapters/anyflip.js", "adapters/heyzine.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/pdf-lib.min.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {}
}
